{
  "expo": {
    "name": "ProxiPoint",
    "slug": "proxipoint-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proxipointmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.callsignsolutions.proxipoint",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ProxiPoint needs location access to alert you to nearby events and peers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.callsignsolutions.proxipoint",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ProxiPoint needs location access to alert you to nearby events and peers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "enableLocationComponent": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}