{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["react"]
  },
  "include": ["app", "src", "expo-env.d.ts"],
  "exclude": ["**/*.test.ts"],
  "extends": "expo/tsconfig.base"
}
